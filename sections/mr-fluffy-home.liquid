{% liquid
  assign logo = section.settings.logo
  assign logo_url = 'mr-fluffy-logo.png' | asset_url
  if logo != blank
    assign logo_url = logo | image_url: width: 1200
  endif
%}

<script>
  window.MR_FLUFFY_LOGO = {{ logo_url | json }};
</script>

<div id="root" class="mr-fluffy-react-root"></div>

<noscript>
  <section class="mf-noscript">
    <img src="{{ logo_url }}" alt="MR Fluffy" width="320" height="206">
    <h1>Everything Your Fluffy Friend Loves</h1>
    <p>Premium pet products for dogs and cats. Please enable JavaScript to experience the full MR Fluffy storefront.</p>
  </section>
</noscript>

{% schema %}
{
  "name": "MR Fluffy React home",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo override"
    }
  ],
  "presets": [
    {
      "name": "MR Fluffy React home"
    }
  ]
}
{% endschema %}
