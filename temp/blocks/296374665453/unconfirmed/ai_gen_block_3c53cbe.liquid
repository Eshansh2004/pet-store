      "default": true
    },
    {
      "type": "text",
      "id": "categories_title",
      "label": "Section title",
      "default": "Shop by Category"
    },
    {
      "type": "collection",
      "id": "category_1",
      "label": "Category 1"
    },
    {
      "type": "collection",
      "id": "category_2",
      "label": "Category 2"
    },
    {
      "type": "collection",
      "id": "category_3",
      "label": "Category 3"
    },
    {
      "type": "collection",
      "id": "category_4",
      "label": "Category 4"
    },
    {
      "type": "collection",
      "id": "category_5",
      "label": "Category 5"
    },
    {
      "type": "collection",
      "id": "category_6",
      "label": "Category 6"
    },
    {
      "type": "header",
      "content": "Popular products"
    },
    {
      "type": "checkbox",
      "id": "show_popular",
      "label": "Show popular products",
